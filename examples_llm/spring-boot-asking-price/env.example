# 한국투자증권 API 인증 정보 설정 예시
# 이 파일을 .env로 복사하여 사용하세요

# 실전투자 API 인증 정보
KIS_APP_KEY=your_production_app_key_here
KIS_APP_SECRET=your_production_app_secret_here

# 모의투자 API 인증 정보
KIS_DEMO_APP_KEY=your_demo_app_key_here
KIS_DEMO_APP_SECRET=your_demo_app_secret_here

# 계좌 정보
KIS_ACCOUNT_NUMBER=12345678
KIS_PRODUCT_CODE=01

# 사용 방법:
# 1. 이 파일을 .env로 복사
# 2. 실제 API 키 정보를 입력
# 3. 환경 변수로 로드하여 애플리케이션 실행
#
# Linux/Mac:
#   source .env
#   mvn spring-boot:run
#
# Windows (PowerShell):
#   Get-Content .env | ForEach-Object { $var = $_.Split('='); [Environment]::SetEnvironmentVariable($var[0], $var[1]) }
#   mvn spring-boot:run
